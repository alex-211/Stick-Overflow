@page
@using Microsoft.Data.SqlClient;
@model Stick_Overflow.Pages.viewProfileModel
@{
    string loggedId = HttpContext.Request.Cookies["logged-in-id"] ?? HttpContext.Session.GetString("user-id");
    string profileId = Request.Query["usr"];

    string name = "";
    string abilitato = "";
    string email = "";
    bool profileError = false;
    string exc = "";

    commonMethods cm = new commonMethods();
    try
    {
        name = cm.getUserDetails(profileId)[0];
        abilitato = cm.getUserDetails(profileId)[2];
        email = cm.getUserDetails(profileId)[1];
    }
    catch (Exception ex)
    {
        profileError = true;
        exc = ex.ToString();
    }
}

<body>
    @{
        if (profileError == true)
        {
            <p>Errore nel caricamento del profilo: @exc</p>
        }
    }
    <script>
        function showForm()
        {
            document.getElementById("form-modifica").style.display = "block";
            document.getElementById("btn-modifica").style.display = "none";
        }
    </script>
    <h4>Profilo di: @name</h4>
    <!--magari aggiungere pfp o bio?-->

    @{
        if (abilitato == "False")
        {
            <p>Questo account è stato disabilitato</p>
        }
        if (loggedId == profileId)
        {
            // aggiungere bottone per modifica profilo

            // che chiama funzione js che mostra un form (già scritto, settato su hidden che js poi renderà visibile)
            <h6>@email</h6>
            <button onclick="showForm()" id="btn-modifica" style="display: block">Modifica profilo</button>

            <form method="post" id="form-modifica" class="form form-control" style="display: none">
                <label>Modifica nickname:</label>
                <input type="text" asp-for="nick" class="form form-control" />

                <label>Modifica email:</label>
                <input type="text" asp-for="email" class="form form-control" />

                <label>Vecchia password:</label>
                <input type="password" asp-for="oldPswd" class="form form-control" />

                <label>Nuova password</label>
                <input type="password" asp-for="pswd" class="form form-control" />

                <label>Conferma nuova password</label>
                <input type="password" asp-for="pswdConf" class="form form-control" />

                <input type="submit" />
            </form>
        }
    }

    @{
        string connData = "Data Source=(LocalDB)\\MSSQLLocalDB;AttachDbFilename=" + "|DataDirectory|\\forum.mdf;Integrated Security=True";
        using (SqlConnection conn = new SqlConnection(connData))
        {
            conn.Open();
            string query = "SELECT m_Id FROM messaggio where u_Id = @id"; // tutte le discussioni di cui fa parte
            using (SqlCommand cmd = new SqlCommand(query, conn))
            {
                if (loggedId != null && profileId == null)
                {
                    cmd.Parameters.AddWithValue("@id", loggedId);
                }
                else
                {
                    cmd.Parameters.AddWithValue("@id", profileId);
                }

                using (SqlDataReader reader = cmd.ExecuteReader())
                {
                    if (reader.Read())
                    {
                        if (reader[0] == null) // non so se è giusto //update non mi sembra funzionare // ne ho provate un po' e non funziona
                        {
                            <p>L'utente non ha interagito con nessuna discussione</p>
                            // forse non funziona
                        }
                        else
                        {
                            // 1 = titolo, 0 = id, 2 desc, poi forse count messaggi 
                            <div>
                                <p href="/viewDisc?disc=@reader[0]">@reader[0]</p> // titolo discussione // update: per ora solo ID
                                <!--desc-->
                                <!--count messaggi oppure l'ultimo-->
                            </div>
                        }
                    }
                }
            }
        }
    }
</body>
