@{
    commonMethods cm = new commonMethods();
    // who is logged method
    string id = Context.Request.Cookies["logged-in-id"] ?? Context.Session.GetString("user-id");
    bool isLogged = !string.IsNullOrEmpty(id);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Stick Overflow</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Stick_Overflow.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">Stick Overflow</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/wip">Cerca</a>
                        </li>
                        @{
                            if (isLogged)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-page="/wip">Crea Discussione</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-page="/viewProfile" asp-route-profile="@id">Profilo</a>
                                </li>
                                if (cm.isAdmin(id))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-area="" asp-page="/database-visualiser">Amministrazione</a>
                                    </li>
                                }
                            }
                        }
                    </ul>
                </div>
                @{
                    if (!isLogged)
                    {
                        <a asp-page="/login" class="btn btn-primary me-2">Login</a>
                        <a asp-page="/signup" class="btn btn-primary">Signup</a>
                    }
                    else
                    {
                        string name = Convert.ToString(cm.getUserDetails(id)[0]);
                        <span class="me-2">Benvenuto, @name</span>
                        <a asp-page="/logout" class="btn btn-outline-danger">Logout</a>

                    }
                }
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - Stick_Overflow - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>