@page
@using Microsoft.Data.SqlClient;
@model Stick_Overflow.Pages.viewDiscModel
@{
    string usrId = HttpContext.Request.Cookies["logged-in-id"] ?? HttpContext.Session.GetString("user-id");
    string disc = Request.Query["disc"];
    string titolo = "";
    string desc = "";
    string nick = "";
    string id = "";
    const string connData = "Data Source=(LocalDB)\\MSSQLLocalDB;AttachDbFilename=" + "|DataDirectory|\\forum.mdf;Integrated Security=True";
    using (SqlConnection conn = new SqlConnection(connData))
    {
        conn.Open();
        const string query = "SELECT d.d_titolo, d.d_desc, u.u_nickname, d.u_Id FROM discussione AS d, utente AS u WHERE d.d_id = @id";
        using (SqlCommand cmd = new SqlCommand(query, conn))
        {
            cmd.Parameters.AddWithValue("@id", disc);
            using (SqlDataReader reader = cmd.ExecuteReader())
            {
                if (reader.Read())
                {
                    titolo = reader[0].ToString();
                    desc = reader[1].ToString();
                    nick = reader[2].ToString();
                    id = reader[3].ToString();
                }
            }
        }
    }
}

<body>
    <h2 class="display-4">@titolo</h2>
    <h6 class="display-6">Autore: <a href="/viewProfile?usr=@id">@nick</a></h6>
    <p>@desc</p>

    @if (usrId != null)
    {
        <form class="form form-control">
            <label>Rispondi</label>
            <input type="text" asp-for="reply" required />
            <input type="hidden" name="id" value="@id" />
            <input type="submit" />
        </form>
    }
</body>
